# ===== Server =====
APP_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
LOG_LEVEL=info

# ===== Database: postgres | mysql | mariadb =====
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=kradchat
DB_PASSWORD=kradchat
DB_NAME=kradchat
DB_SSLMODE=disable
DB_MAX_CONNS=50

# ===== JWT (min 32 belgi — HS256 uchun 256-bit) =====
JWT_SECRET=change-me-to-a-long-random-secret-string-min-32-chars-xxxx
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=168h
JWT_ISSUER=kradchat

# ===== Upload =====
UPLOAD_DIR=./web/static/uploads
MAX_FILE_SIZE=52428800
UPLOAD_CHUNK_SIZE=1048576

# ===== Security =====
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=1m
WS_MSG_PER_MIN=60
WS_MSG_BURST=10
WS_MAX_MESSAGE_SIZE=65536
BCRYPT_COST=12
PENDING_SESSION_TTL=15m

# ===== Backgrounds =====
BACKGROUND_DIR=./web/static/backgrounds
BACKGROUND_POLL=30s
BACKGROUND_MAX_SIZE=20971520

# ===== Static =====
STATIC_DIR=./web/static
